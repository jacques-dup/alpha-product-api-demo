{
  "local": {
    "productBaseUrl": "http://localhost:5241",
    "idpBaseUrl": "https://dev.auth.alpha.org",
    "Security": {
      "Auth": {
        "product_clientcredentials_read": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client ID": "{{webApiClientId}}",
          "Client Secret": "{{webApiClientSecret}}",
          "Scope": "alpha.idp.read",
          "Token URL": "https://dev.auth.alpha.org/connect/token",
          "Client Credentials": "in body",
          "Acquire Automatically": true
        }
      }
    }
  },
  "local-https": {
    "productBaseUrl": "https://localhost:7127",
    "idpBaseUrl": "https://dev.auth.alpha.org",
    "Security": {
      "Auth": {
        "product_clientcredentials_read": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Client ID": "{{webApiClientId}}",
          "Client Secret": "{{webApiClientSecret}}",
          "Scope": "alpha.idp.read",
          "Token URL": "https://dev.auth.alpha.org/connect/token",
          "Client Credentials": "in body",
          "Acquire Automatically": true
        }
      }
    }
  }
}
