###############################################################################
# Product payloads
###############################################################################

### Products
GET {{productBaseUrl}}/product/products
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Products filtered by course type (family code)
GET {{productBaseUrl}}/product/products?courseType=alpha-film-series
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Products filtered by audience
GET {{productBaseUrl}}/product/products?audience=adults
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Products for a listed country
GET {{productBaseUrl}}/product/products?country=gb
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Products for a country that maps to a regional market (ke -> ssa)
GET {{productBaseUrl}}/product/products?country=ke
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Products for an unknown country → 400
GET {{productBaseUrl}}/product/products?country=xx
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

> {%
    client.test("unknown country is a bad request", function () {
        client.assert(response.status === 400, "expected 400, got " + response.status);
    });
%}

### Products with language fallback
GET {{productBaseUrl}}/product/products?language=fr
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Product by code
GET {{productBaseUrl}}/product/products/code/{{productCode}}
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Product by code, language fallback
GET {{productBaseUrl}}/product/products/code/{{productCode}}?language=fr
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Product by id
GET {{productBaseUrl}}/product/products/{{productId}}
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

### Unknown product id → 404
GET {{productBaseUrl}}/product/products/00000000-0000-4000-a000-000000000000
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

> {%
    client.test("unknown product is not found", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
%}


