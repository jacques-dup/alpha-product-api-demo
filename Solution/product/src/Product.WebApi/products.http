### Product.WebApi — read API (`/product`)
#
# Auth: client-credentials bearer from the Alpha Identity Provider, scope `alpha.idp.read`.
# There is no end-user login on this API.
#
# Setup:
#   1. Select the `local` (or `local-https`) environment in the HTTP client run panel.
#   2. Put the demo client id/secret in `http-client.private.env.json` (gitignored).
#   3. Run the application root, then run any request below.
#   4. Swagger UI (human explorer): {{productBaseUrl}}/swagger — Authorize, paste the token.
#
# `{{$auth.token("product_clientcredentials_read")}}` makes the HTTP client fetch and
# cache the token itself, using the OAuth2 block in `http-client.env.json`.

@familyId = a0000000-0000-4000-a000-000000000001
@tagId = a0000000-0000-4000-a000-000000000301
@productId = a0000000-0000-4000-a000-000000000001
@itemId = a0000000-0000-4000-a000-000000000001
@assetId = a0000000-0000-4000-a000-000000000001
@productCode = alpha-film-series


###############################################################################
# Token — raw client-credentials request
###############################################################################

### Fetch an access token directly (inspect scope/aud/exp before using the API)
# @name clientCredentialsToken
POST {{idpBaseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{webApiClientId}}&client_secret={{webApiClientSecret}}&scope=alpha.idp.read

> {%
    client.test("token issued", function () {
        client.assert(response.status === 200, "status " + response.status + ": " + JSON.stringify(response.body));
        client.assert(response.body.access_token !== undefined, "no access_token in response");
    });
    client.global.set("rawAccessToken", response.body.access_token);
%}

### Discovery document (issuer, token endpoint, signing keys)
GET {{idpBaseUrl}}/.well-known/openid-configuration
Accept: application/json


###############################################################################
# Negative cases — the API must not serve product data anonymously
###############################################################################

### No token → 401
GET {{productBaseUrl}}/product/languages
Accept: application/json

> {%
    client.test("anonymous is rejected", function () {
        client.assert(response.status === 401, "expected 401, got " + response.status);
    });
%}

### Garbage token → 401
GET {{productBaseUrl}}/product/languages
Accept: application/json
Authorization: Bearer not-a-real-token

> {%
    client.test("invalid token is rejected", function () {
        client.assert(response.status === 401, "expected 401, got " + response.status);
    });
%}

### Write method on a read-only API → 404/405, never 200
POST {{productBaseUrl}}/product/products
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

{}

> {%
    client.test("read API exposes no write route", function () {
        client.assert(response.status === 404 || response.status === 405, "got " + response.status);
    });
%}


###############################################################################
# Reference data
###############################################################################

### Languages
GET {{productBaseUrl}}/product/languages
Accept: application/json
Authorization: Bearer {{$auth.token("product_clientcredentials_read")}}

> {%
    client.test("authorised read succeeds", function () {
        client.assert(response.status === 200, "expected 200, got " + response.status);
    });
%}

